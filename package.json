{
  "name": "ai-code-analyzer-research-platform",
  "version": "1.0.0",
  "description": "AI-powered code analysis and product research platform with MCP integrations",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "npm run lint && npm run test",
    "install:brave": "npm install @brave/brave-search-mcp-server",
    "install:playwright": "npm install @playwright/mcp",
    "start:brave": "npx @brave/brave-search-mcp-server --transport http --port 8080",
    "start:playwright": "npx playwright-mcp --port 3001",
    "docker:build": "docker build -t ai-analyzer .",
    "docker:run": "docker run -p 3000:3000 ai-analyzer"
  },
  "keywords": [
    "ai",
    "code-analysis",
    "product-research",
    "mcp",
    "brave-search",
    "playwright",
    "openai",
    "automation"
  ],
  "author": "Tina Marcus",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "openai": "^4.20.0",
    "anthropic": "^0.9.0",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^8.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.0",
    "prom-client": "^15.0.0",
    "rate-limiter-flexible": "^3.0.8",
    "@brave/brave-search-mcp-server": "^2.0.10",
    "@playwright/mcp": "^0.0.39"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tinamarcus/ai-code-analyzer-platform.git"
  },
  "bugs": {
    "url": "https://github.com/tinamarcus/ai-code-analyzer-platform/issues"
  },
  "homepage": "https://github.com/tinamarcus/ai-code-analyzer-platform#readme"
}
