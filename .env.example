# AI Ready Website - Environment Configuration Template
# Copy this file to .env.local and fill in your actual API keys

# Required API Keys for AI Ready Website
OPENAI_API_KEY=your_openai_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional API Keys (not required for basic functionality)
BRAVE_API_KEY=your_brave_api_key_here

# Development Configuration
NODE_ENV=development
PORT=3000
